# Qwen3-TTS 0.6B Base provides real rapid voice cloning with the lightest practical footprint.
# Switch to Qwen/Qwen3-TTS-12Hz-1.7B-Base when a capable NVIDIA GPU has sufficient VRAM.
QWEN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# Leave unset to auto-detect CUDA, otherwise use cpu or cuda:0.
# FORCE_DEVICE=

# Keep all profiles and generated files local. Relative paths are resolved from backend/.
# STORAGE_ROOT=../storage

# Vite development host allowed to call FastAPI.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
